{
  "name": "clearcsv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm test:api && pnpm build && pnpm build:api",
    "build:api": "tsc -p api/tsconfig.json",
    "test:api": "vitest run --config api/vitest.config.ts",
    "test:integration": "vitest run --config api/vitest.integration.config.ts",
    "api:start": "node --env-file-if-exists=.env dist-api/server.js",
    "db:migrate": "node --env-file-if-exists=.env dist-api/migrate.js",
    "test:containers": "node scripts/container-smoke.mjs",
    "test:db": "node scripts/integration-test.mjs",
    "demo:devops": "node scripts/devops-demo.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "fastify": "5.12.7",
    "lucide-react": "1.55.0",
    "node-pg-migrate": "9.0.0",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

API_IMAGE=ghcr.io/your-owner/clearcsv-api:sha-0123456789abcdef0123456789abcdef01234567
APP_VERSION=sha-0123456789abcdef0123456789abcdef01234567
# Set the API host's VPN address for access from the frontend host.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
PGHOST=db.your-private-domain.example
PGPORT=5432
PGDATABASE=clearcsv
PGUSER=clearcsv
POSTGRES_PASSWORD_FILE=/etc/clearcsv/secrets/postgres-password
CORS_ORIGIN=https://clearcsv.your-domain.example
# Create this directory. For verified PostgreSQL TLS put ca.pem here and set
# PGSSLROOTCERT=/run/certs/ca.pem and PGSSLMODE=verify-full.
# disable uses the trusted VPN transport.
API_CERTS_DIR=/etc/clearcsv/certs
PGSSLMODE=disable
PGSSLROOTCERT=

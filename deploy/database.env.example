# Set the database host's VPN address so only the API host can reach port 5432.
DB_PRIVATE_IP=127.0.0.1
DB_PORT=5432
POSTGRES_DB=clearcsv
POSTGRES_USER=clearcsv
POSTGRES_PASSWORD_FILE=/etc/clearcsv/secrets/postgres-password
# Must already exist on this host: docker volume create clearcsv-postgres-data
POSTGRES_VOLUME=clearcsv-postgres-data

# Copy to .env. Create secrets/postgres_password with a private, generated password.
# Passwords are read from files; do not put them in this file or commit them.
# Linux: keep secrets/ mode 0700 and its password file mode 0444, so the
# nonroot API can read the mounted file without exposing the host directory.
APP_VERSION=1.0.0
VERSION=1.0.0
FRONTEND_IMAGE=clearcsv-frontend
API_IMAGE=clearcsv-api
FRONTEND_PORT=8080
API_PORT=3000
PGDATABASE=clearcsv
PGUSER=clearcsv
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
CORS_ORIGIN=http://127.0.0.1:8080
# API_UPSTREAM is the backend address reachable from the frontend container.
API_UPSTREAM=api:3000
